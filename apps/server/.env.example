# Required for authentication. Generate each value with: openssl rand -base64 48
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# Required for OAuth redirects in production. No trailing slash.
SERVER_URL=https://relic-ai-server.vercel.app
WEB_URL=https://your-web-app.vercel.app

# Required when an OAuth callback, token refresh, logout, or /auth/me accesses PostgreSQL.
# Use the pooled Postgres connection URL provided by your database host.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional token lifetimes
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OAUTH_STATE_EXPIRES_IN=10m

# Optional: leave a provider's two values unset to disable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------------
# relic-ai server (apps/server) - environment variables
# Copy this file to .env and fill in real values.
#   cp example.env .env
# NEVER commit the real .env file.
# ------------------------------------------------------------------

# Node environment: development | test | production
NODE_ENV=development

# Base URLs (no trailing slash)
SERVER_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Shared cookie domain for auth cookies.
# Leave empty when frontend/backend are on separate domains.
# Set to ".yourdomain.com" (leading dot) when using a shared domain.
COOKIE_DOMAIN=

# JWT signing secrets (use long random strings)
JWT_SECRET="replace-with-a-long-random-secret"
REFRESH_TOKEN_SECRET="replace-with-another-long-random-secret"

# Token lifetimes
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OAUTH_STATE_EXPIRES_IN=10m

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# NVIDIA NIM API (https://build.nvidia.com -> "Get API Key")
NVIDIA_API_KEY="nvapi-..."

# LLM settings (defaults shown; override only if needed)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=google/diffusiongemma-26b-a4b-it
LLM_TEMPERATURE=1
LLM_TOP_P=0.95
LLM_MAX_TOKENS=4096

{
  "name": "hono",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate --schema ../../packages/db/prisma/schema.prisma --config ../../packages/db/prisma.config.ts && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:dotenv --banner:js=\"import{createRequire as __createRequire}from'node:module';const require=__createRequire(import.meta.url);\"",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "db": "workspace:*",
    "dotenv": "^17.4.2",
    "hono": "^4.13.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@hono/node-server": "^1.16.0",
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.2",
    "prisma": "^7.9.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.2"
  }
}
{
  "name": "hono",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "db:generate": "prisma generate --schema prisma/schema.prisma --config prisma.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "build": "pnpm db:generate",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.16.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.2",
    "prisma": "^7.9.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.2"
  }
}